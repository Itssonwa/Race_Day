@model RaceDay.Models.Category
@{ ViewData["Title"] = "Edit category"; }

<h1 class="h3">Edit category for @ViewBag.EventName</h1>
<hr />
<div class="row"><div class="col-md-6">
    <form asp-action="Edit" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_CategoryForm" model="Model" />
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
