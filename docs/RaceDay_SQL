Create Database Race_Day;

Create Table Participant(
ParticipantID tinyint Primary Key, 
Name Varchar(20) Not Null); 

Create Table Results(
ResultID tinyint Primary Key,
Description Varchar(30) Not Null,
ParticipantID tinyint,
Foreign Key(ParticipantID) References Participant(ParticipantID));

Create Table Organisers(
OrganiserID tinyint Primary Key, 
OrganiserName Varchar(20) Not Null);

Create Table Event(
EventID tinyint Primary Key,
Location Varchar(30),
EventName Varchar(20) Not Null,
EventYear int Not Null,
OrganiserID tinyint,
Foreign Key (OrganiserID) References Organiser(OrganiserID));

Create Table Role (
RoleID tinyint PRIMARY KEY,
RoleName Varchar(20) NOT NULL,
Description Varchar(50));

Create Table Users (
UserID tinyint PRIMARY KEY,
UserName Varchar(20) NOT NULL,
RoleID tinyint ,
FOREIGN Key (RoleID) References Role(RoleID));

Create Table Catagory(
CatagoryID tinyint Primary Key,
Description Varchar(30),
EventID tinyint,
Foreign Key (EventID) References Event(EventID));

Create Table EventEnrolment(
EventEnrolmentID int Primary Key,
Date date Not Null, 
Time time Not Null,
EventID tinyint,
ParticipantID tinyint,
Foreign Key (EventID) References Event(EventID),
Foreign Key(ParticipantID) References Participant(ParticipantID));

